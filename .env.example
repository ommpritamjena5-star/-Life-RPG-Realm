# ==========================================
# LIFE RPG ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env or backend/.env and replace placeholders.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/liferpg
JWT_SECRET=your_super_secret_mythic_jwt_key_here

# Gmail SMTP Delivery (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password
EMAIL_FROM="Life RPG Realm" <your_email@gmail.com>
