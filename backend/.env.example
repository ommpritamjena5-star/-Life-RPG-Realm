# ==========================================
# LIFE RPG BACKEND ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your custom values.
# NEVER commit the actual .env file with real secrets to GitHub!

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection URI (Optional - fallback in-memory/JSON store is used if omitted)
# Example: mongodb://127.0.0.1:27017/liferpg OR mongodb+srv://<user>:<password>@cluster0.mongodb.net/liferpg
MONGODB_URI=mongodb://127.0.0.1:27017/liferpg

# JWT Secret Key for Authenticating Hero Tokens
JWT_SECRET=your_super_secret_mythic_jwt_key_here_change_in_production

# ==========================================
# GMAIL SMTP NOTIFICATION SETTINGS (Optional)
# ==========================================
# For real email delivery (Welcome, Password Recovery Rune Codes, Login Alerts),
# enable 2-Step Verification on your Google Account and generate a 16-character
# App Password at: https://myaccount.google.com/apppasswords

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password
EMAIL_FROM="Life RPG Realm" <your_email@gmail.com>
